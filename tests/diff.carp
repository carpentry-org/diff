(load "Test.carp")

(load "diff.carp")

(use-all Diff Test)

; 0xBB is `»` in latin-1: one byte, zero utf-8 characters
(defn latin1-raquo [] (String.from-bytes &[187b]))

(defn main []
  (with-test test
    (assert-equal test
      &[(Eq [1 2 3])]
      &(Diff.eq &(diff &[1 2 3] &[1 2 3]))
      "diffing equal lists means everything is equal")
    (assert-equal test
      &[(Eq [1]) (Insertion [2]) (Deletion [4]) (Eq [3])]
      &(diff &[1 4 3] &[1 2 3])
      "diffing non-equal lists means we get a diff")
    (assert-equal test
      &[(Eq [@"I"]) (Insertion [@"was"]) (Deletion [@"am"]) (Eq [@"okay"])]
      &(string-diff "I am okay" "I was okay")
      "diffing strings works as well")
    (assert-equal test
      &[]
      &(diff &[] &(the (Array Int) []))
      "diffing two empty arrays returns empty")
    (assert-equal test
      &[(Insertion [1 2 3])]
      &(diff &[] &[1 2 3])
      "diffing empty old with non-empty new returns insertion")
    (assert-equal test
      &[(Deletion [1 2 3])]
      &(diff &[1 2 3] &[])
      "diffing non-empty old with empty new returns deletion")
    (assert-equal test
      &[(Eq [42])]
      &(Diff.eq &(diff &[42] &[42]))
      "diffing single-element arrays with same value")
    (assert-equal test
      &[(Insertion [2]) (Deletion [1])]
      &(diff &[1] &[2])
      "diffing single-element arrays with different values")
    (assert-equal test
      &[(Insertion [4 5 6]) (Deletion [1 2 3])]
      &(diff &[1 2 3] &[4 5 6])
      "completely different arrays")
    (assert-equal test
      &[(Eq [1 2]) (Insertion [3 4])]
      &(diff &[1 2] &[1 2 3 4])
      "old is a prefix of new")
    (assert-equal test
      &[(Eq [1 2]) (Deletion [3 4])]
      &(diff &[1 2 3 4] &[1 2])
      "new is a prefix of old")
    (assert-equal test
      &[(Insertion [1 2]) (Eq [3 4])]
      &(diff &[3 4] &[1 2 3 4])
      "old is a suffix of new")
    (assert-equal test
      &[(Deletion [1 2]) (Eq [3 4])]
      &(diff &[1 2 3 4] &[3 4])
      "new is a suffix of old")
    (assert-equal test
      &[(Insertion [1]) (Eq [1 2]) (Insertion [2]) (Eq [1])]
      &(diff &[1 2 1] &[1 1 2 2 1])
      "repeats around an insertion keep the earliest longest run")
    (assert-equal test
      &[(Insertion [1]) (Eq [1 2]) (Deletion [2]) (Eq [1])]
      &(diff &[1 2 2 1] &[1 1 2 1])
      "repeats around a deletion keep the earliest longest run")

    (assert-equal test
      &[1 2 3]
      &(Diff.apply &(diff &[1 2 3] &[1 2 3]))
      "apply on equal arrays returns the same array")
    (assert-equal test
      &[1 2 3]
      &(Diff.apply &(diff &[1 4 3] &[1 2 3]))
      "apply reconstructs the new array")
    (assert-equal test
      &(the (Array Int) [])
      &(Diff.apply &(diff &[1 2 3] &[]))
      "apply on all-deletion diff returns empty")
    (assert-equal test
      &[1 2 3]
      &(Diff.apply &(diff &[] &[1 2 3]))
      "apply on all-insertion diff returns the inserted elements")
    (assert-equal test
      &(the (Array Int) [])
      &(Diff.apply &(diff &[] &(the (Array Int) [])))
      "apply on empty diff returns empty")
    (assert-equal test
      &[1 2 3 4]
      &(Diff.apply &(diff &[1 2] &[1 2 3 4]))
      "apply with appended elements")

    ; hand-built mixed diffs: reconstructing either side from the diff
    ; structure alone, independent of the diff algorithm
    (assert-equal test
      &[1 2 10 20 4 30]
      &(Diff.apply
        &[(Eq [1 2])
          (Insertion [10 20])
          (Deletion [3])
          (Eq [4])
          (Deletion [5 6])
          (Insertion [30])])
      "apply on mixed diff collects Eq+Insertion, skips Deletion")
    (assert-equal test
      &[1 2 3 4 5 6]
      &(Diff.revert
        &[(Eq [1 2])
          (Insertion [10 20])
          (Deletion [3])
          (Eq [4])
          (Deletion [5 6])
          (Insertion [30])])
      "revert on mixed diff collects Eq+Deletion, skips Insertion")
    (assert-equal test
      &[@"hello" @"brave" @"new" @"world"]
      &(Diff.apply
        &[(Eq [@"hello"])
          (Deletion [@"cruel" @"old"])
          (Insertion [@"brave" @"new"])
          (Eq [@"world"])])
      "apply on string mixed diff reconstructs the new side")
    (assert-equal test
      &[@"hello" @"cruel" @"old" @"world"]
      &(Diff.revert
        &[(Eq [@"hello"])
          (Deletion [@"cruel" @"old"])
          (Insertion [@"brave" @"new"])
          (Eq [@"world"])])
      "revert on string mixed diff reconstructs the old side")

    (assert-equal test
      &[1 2 3]
      &(Diff.revert &(diff &[1 2 3] &[1 2 3]))
      "revert on equal arrays returns the same array")
    (assert-equal test
      &[1 4 3]
      &(Diff.revert &(diff &[1 4 3] &[1 2 3]))
      "revert reconstructs the old array")
    (assert-equal test
      &[1 2 3]
      &(Diff.revert &(diff &[1 2 3] &[]))
      "revert on all-deletion diff returns the deleted elements")
    (assert-equal test
      &(the (Array Int) [])
      &(Diff.revert &(diff &[] &[1 2 3]))
      "revert on all-insertion diff returns empty")
    (assert-equal test
      &(the (Array Int) [])
      &(Diff.revert &(diff &[] &(the (Array Int) [])))
      "revert on empty diff returns empty")
    (assert-equal test
      &[1 2 3 4]
      &(Diff.revert &(diff &[1 2 3 4] &[1 2]))
      "revert with removed suffix")

    (assert-equal test
      &[(Eq [@"a"]) (Insertion [@"new"]) (Deletion [@"old"]) (Eq [@"b"])]
      &(line-diff "a
old
b" "a
new
b")
      "line-diff splits on newlines and diffs")
    (assert-equal test &[(Eq [@"same" @"lines"])] &(Diff.eq &(line-diff "same
lines" "same
lines")) "line-diff of identical strings is all equal")

    (assert-equal test
      &[(Eq [\a]) (Insertion [\x]) (Deletion [\b]) (Eq [\c])]
      &(char-diff "abc" "axc")
      "char-diff diffs individual characters")
    (assert-equal test
      &[(Eq [\h \e \l \l \o])]
      &(Diff.eq &(char-diff "hello" "hello"))
      "char-diff of identical strings is all equal")

    (assert-equal test &(String.concat &[@"@@ -1,3 +1,3 @@
" @" line1
" @"+changed
" @"-line2
" @" line3
" @"\\ No newline at end of file
"]) &(unified &(line-diff "line1
line2
line3" "line1
changed
line3")) "unified renders single-hunk diff with correct header")
    (assert-equal test "" &(unified &(line-diff "same
text" "same
text")) "unified of identical strings is empty")
    (assert-equal test &(String.concat &[@"@@ -1,4 +1,4 @@
" @"+new
" @"-old
" @" a
" @" b
" @" c
" @"\\ No newline at end of file
"]) &(unified &(line-diff "old
a
b
c" "new
a
b
c")) "unified handles change at start")
    (assert-equal test &(String.concat &[@"@@ -1,4 +1,4 @@
" @" a
" @" b
" @" c
" @"+new
" @"\\ No newline at end of file
" @"-old
" @"\\ No newline at end of file
"]) &(unified &(line-diff "a
b
c
old" "a
b
c
new")) "unified handles change at end")
    (assert-equal test &(String.concat &[@"@@ -1,5 +1,5 @@
" @" a
" @"+BB
" @"-b
" @" c
" @" d
" @" e
" @"@@ -8,4 +8,4 @@
" @" h
" @" i
" @" j
" @"+KK
" @"\\ No newline at end of file
" @"-k
" @"\\ No newline at end of file
"]) &(unified &(line-diff "a
b
c
d
e
f
g
h
i
j
k" "a
BB
c
d
e
f
g
h
i
j
KK")) "unified generates multiple hunks for distant changes")

    (assert-equal test
      3
      (Diff.lcs-length &[1 2 3] &[1 2 3])
      "lcs-length of identical arrays is their length")
    (assert-equal test
      2
      (Diff.lcs-length &[1 4 3] &[1 2 3])
      "lcs-length of partially matching arrays")
    (assert-equal test
      0
      (Diff.lcs-length &[1 2 3] &[4 5 6])
      "lcs-length of completely different arrays is 0")
    (assert-equal test
      0
      (Diff.lcs-length &[] &(the (Array Int) []))
      "lcs-length of two empty arrays is 0")
    (assert-equal test
      0
      (Diff.lcs-length &[] &[1 2 3])
      "lcs-length with one empty array is 0")
    (assert-equal test
      2
      (Diff.lcs-length &[1 2] &[1 2 3 4])
      "lcs-length when one is prefix of other")
    (assert-equal test
      0
      (Diff.lcs-length &[1 2 3] &[])
      "lcs-length with an empty new array is 0")
    (assert-equal test
      1
      (Diff.lcs-length &[5] &[5])
      "lcs-length of equal single elements is 1")
    (assert-equal test
      0
      (Diff.lcs-length &[5] &[6])
      "lcs-length of different single elements is 0")
    (assert-equal test
      3
      (Diff.lcs-length &[1 3 5] &[1 2 3 4 5])
      "lcs-length when old is a subsequence of new")
    (assert-equal test
      2
      (Diff.lcs-length &[1 2 3 4 5] &[2 4])
      "lcs-length when new is a subsequence of old")

    (assert-equal test
      0
      (Diff.edit-distance &[1 2 3] &[1 2 3])
      "edit-distance of identical arrays is 0")
    (assert-equal test
      2
      (Diff.edit-distance &[1 4 3] &[1 2 3])
      "edit-distance with one substitution is 2 (delete + insert)")
    (assert-equal test
      6
      (Diff.edit-distance &[1 2 3] &[4 5 6])
      "edit-distance of completely different arrays")
    (assert-equal test
      0
      (Diff.edit-distance &[] &(the (Array Int) []))
      "edit-distance of two empty arrays is 0")
    (assert-equal test
      3
      (Diff.edit-distance &[] &[1 2 3])
      "edit-distance with one empty array")
    (assert-equal test
      2
      (Diff.edit-distance &[1 2] &[1 2 3 4])
      "edit-distance when one is prefix of other")
    (assert-equal test
      3
      (Diff.edit-distance &[1 2 3] &[])
      "edit-distance with an empty new array")
    (assert-equal test
      0
      (Diff.edit-distance &[5] &[5])
      "edit-distance of equal single elements is 0")
    (assert-equal test
      2
      (Diff.edit-distance &[5] &[6])
      "edit-distance of different single elements is 2")
    (assert-equal test
      2
      (Diff.edit-distance &[1 3 5] &[1 2 3 4 5])
      "edit-distance when old is a subsequence of new")
    (assert-equal test
      3
      (Diff.edit-distance &[1 2 3 4 5] &[2 4])
      "edit-distance when new is a subsequence of old")

    (assert-equal test
      1.0
      (Diff.similarity &[1 2 3] &[1 2 3])
      "similarity of identical arrays is 1.0")
    (assert-equal test
      0.0
      (Diff.similarity &[1 2 3] &[4 5 6])
      "similarity of completely different arrays is 0.0")
    (assert-equal test
      1.0
      (Diff.similarity &[] &(the (Array Int) []))
      "similarity of two empty arrays is 1.0")
    (assert-equal test
      0.0
      (Diff.similarity &[] &[1 2 3])
      "similarity with one empty array is 0.0")
    (assert-equal test
      0.75
      (Diff.similarity &[1 3 5] &[1 2 3 4 5])
      "similarity when one is a subsequence of the other")

    ; inputs where the Eq hunks of diff are not a longest common subsequence
    (assert-equal test
      2
      (Diff.lcs-length &[1 2 3] &[3 1 3])
      "lcs-length with an out-of-order shared element")
    (assert-equal test
      2
      (Diff.edit-distance &[1 2 3] &[3 1 3])
      "edit-distance with an out-of-order shared element")
    (assert-equal test
      3
      (Diff.lcs-length &[1 1 1] &[1 2 1 1])
      "lcs-length with a repeated element")
    (assert-equal test
      1
      (Diff.edit-distance &[1 1 1] &[1 2 1 1])
      "edit-distance with a repeated element")
    (assert-equal test
      5
      (Diff.lcs-length &[3 1 2 1 3 2] &[3 2 1 2 3 2])
      "lcs-length of interleaved arrays")
    (assert-equal test
      2
      (Diff.edit-distance &[3 1 2 1 3 2] &[3 2 1 2 3 2])
      "edit-distance of interleaved arrays")
    (assert-equal test
      0.5
      (Diff.similarity &[1 2] &[2 1 1 1 3 2])
      "similarity counts every element of the LCS")

    ; str/prn
    (assert-equal test
      "(Eq [1 2 3])"
      &(str &(Eq [1 2 3]))
      "str of Eq shows variant and contents")
    (assert-equal test
      "(Insertion [42])"
      &(str &(Insertion [42]))
      "str of Insertion shows variant and contents")
    (assert-equal test
      "(Deletion [7 8])"
      &(str &(Deletion [7 8]))
      "str of Deletion shows variant and contents")
    (assert-equal test
      "(Insertion [10 20])"
      &(str &(Insertion [10 20]))
      "str of Insertion with multiple elements")

    ; unified-with-context
    (assert-equal test &(String.concat &[@"@@ -2,1 +2,1 @@
" @"+changed
" @"-line2
"]) &(unified-with-context &(line-diff "line1
line2
line3" "line1
changed
line3") 0) "unified-with-context 0 omits context lines")
    (assert-equal test &(String.concat &[@"@@ -1,3 +1,3 @@
" @" line1
" @"+changed
" @"-line2
" @" line3
" @"\\ No newline at end of file
"]) &(unified-with-context &(line-diff "line1
line2
line3" "line1
changed
line3") 3) "unified-with-context 3 matches unified default")
    (assert-equal test &(unified &(line-diff "line1
line2
line3" "line1
changed
line3")) &(unified-with-context &(line-diff "line1
line2
line3" "line1
changed
line3") 3) "unified-with-context 3 is identical to unified")
    (assert-equal test &(String.concat &[@"@@ -1,3 +1,3 @@
" @" a
" @"+BB
" @"-b
" @" c
" @"@@ -5,3 +5,3 @@
" @" e
" @"+FF
" @"-f
" @" g
" @"\\ No newline at end of file
"]) &(unified-with-context &(line-diff "a
b
c
d
e
f
g" "a
BB
c
d
e
FF
g") 1) "unified-with-context 1 splits hunks with enough gap")
    (assert-equal test
      "@@ -3,0 +4,1 @@\n+X\n"
      &(unified-with-context &(line-diff "a\nb\nc\nd\ne" "a\nb\nc\nX\nd\ne") 0)
      "a zero-count range names the line before it")
    (assert-equal test
      "@@ -4,1 +3,0 @@\n-d\n"
      &(unified-with-context &(line-diff "a\nb\nc\nd\ne" "a\nb\nc\ne") 0)
      "a zero-count new range names the line before it")
    (assert-equal test
      "@@ -0,0 +1,2 @@\n+a\n+b\n\\ No newline at end of file\n"
      &(unified &(diff &(the (Array String) []) &[@"a" @"b"]))
      "an empty old side is -0,0")
    (assert-equal test
      "@@ -1,2 +0,0 @@\n-a\n-b\n\\ No newline at end of file\n"
      &(unified &(diff &[@"a" @"b"] &(the (Array String) [])))
      "an empty new side is +0,0")
    (assert-equal test
      "@@ -1,4 +1,4 @@\n+X\n-a\n b\n c\n d\n"
      &(unified &(line-diff "a\nb\nc\nd\ne\nf" "X\nb\nc\nd\ne\nf"))
      "unified ends the last hunk after ctx context lines")
    (assert-equal test
      "@@ -1,2 +1,2 @@\n a\n-b\n\\ No newline at end of file\n+b\n"
      &(unified &(line-diff "a\nb" "a\nb\n"))
      "unified writes an added final newline as a change of the last line")
    (assert-equal test
      "@@ -1,2 +1,2 @@\n a\n-b\n+b\n\\ No newline at end of file\n"
      &(unified &(line-diff "a\nb\n" "a\nb"))
      "unified writes a removed final newline as a change of the last line")
    (assert-equal test
      "@@ -1,2 +1,2 @@\n a\n+B\n-b\n"
      &(unified &(line-diff "a\nb\n" "a\nB\n"))
      "unified does not count a final newline as a line")
    (assert-equal test
      "@@ -0,0 +1,1 @@\n+a\n\\ No newline at end of file\n"
      &(unified &(line-diff "" "a"))
      "unified reads an empty old text as no lines")
    (assert-equal test
      "@@ -1,1 +0,0 @@\n-a\n\\ No newline at end of file\n"
      &(unified &(line-diff "a" ""))
      "unified reads an empty new text as no lines")

    ; patch — apply a unified diff to an original document
    (assert-equal test &(Maybe.Just @"line1
changed
line3") &(patch "line1
line2
line3" &(unified &(line-diff "line1
line2
line3" "line1
changed
line3"))) "patch round-trips a single-hunk change in the middle")
    (assert-equal test &(Maybe.Just @"new
a
b
c") &(patch "old
a
b
c" &(unified &(line-diff "old
a
b
c" "new
a
b
c"))) "patch round-trips a change at the start")
    (assert-equal test &(Maybe.Just @"a
b
c
new") &(patch "a
b
c
old" &(unified &(line-diff "a
b
c
old" "a
b
c
new"))) "patch round-trips a change at the end")
    (assert-equal test &(Maybe.Just @"a
BB
c
d
e
f
g
h
i
j
KK") &(patch "a
b
c
d
e
f
g
h
i
j
k" &(unified &(line-diff "a
b
c
d
e
f
g
h
i
j
k" "a
BB
c
d
e
f
g
h
i
j
KK"))) "patch round-trips multiple hunks, copying the untouched gap")
    (assert-equal test &(Maybe.Just @"a
X
Y
b") &(patch "a
b" &(unified &(line-diff "a
b" "a
X
Y
b"))) "patch round-trips a pure insertion")
    (assert-equal test &(Maybe.Just @"a
b") &(patch "a
X
Y
b" &(unified &(line-diff "a
X
Y
b" "a
b"))) "patch round-trips a pure deletion")
    (assert-equal test &(Maybe.Just @"same
text") &(patch "same
text" &(unified &(line-diff "same
text" "same
text"))) "patch on an empty diff returns the original unchanged")
    (assert-equal test &(Maybe.Just @"a
B
c") &(patch "a
b
c" "@@ -2 +2 @@
-b
+B
") "patch accepts a count-omitted hunk header (@@ -2 +2 @@)")
    (assert-equal test &(the (Maybe String) (Maybe.Nothing)) &(patch "x
y
z" &(unified &(line-diff "a
b
c" "a
B
c"))) "patch returns Nothing when a context line does not match the original")
    (assert-equal test &(the (Maybe String) (Maybe.Nothing)) &(patch "a
b" "@@ garbage @@
 a
") "patch returns Nothing on a malformed hunk header")
    (assert-equal test &(the (Maybe String) (Maybe.Nothing)) &(patch "a
b" "@@ -1,2 +1,2 @@
 a
é
 b") "patch does not abort on a line that is a single multi-byte character")
    (assert-equal test &(the (Maybe String) (Maybe.Nothing)) &(patch "a
b" &(String.concat &[@"@@ -1,2 +1,2 @@
 a
" (latin1-raquo) @"
 b"])) "patch does not abort on a body line that is a single continuation byte")
    (assert-equal test &(the (Maybe String) (Maybe.Nothing)) &(patch "a
b" &(String.concat &[@"@@ " (latin1-raquo) @" @@
 a
"])) "patch does not abort on a continuation byte in the hunk header")
    (assert-equal test &(Maybe.Just (String.concat &[(latin1-raquo) @"
b"])) &(patch &(String.concat &[(latin1-raquo) @"
b"]) &(String.concat &[@"@@ -1,2 +1,2 @@
 " (latin1-raquo) @"
 b
\\ No newline at end of file"])) "patch applies a no-op patch to a latin-1 document")
    (assert-equal test &(Maybe.Just (String.concat &[(latin1-raquo) @"
B"])) &(patch &(String.concat &[(latin1-raquo) @"
b"]) &(unified &(line-diff &(String.concat &[(latin1-raquo) @"
b"]) &(String.concat &[(latin1-raquo) @"
B"])))) "patch round-trips a diff of a latin-1 document")
    (assert-equal test
      &(Maybe.Just @"a\nb\nc\nX\nd\ne")
      &(patch "a\nb\nc\nd\ne" "@@ -3,0 +4 @@\n+X")
      "patch puts a zero-count hunk after the line it names")
    (assert-equal test
      &(Maybe.Just @"a\nb\nc\nd\ne\nY\nZ\n")
      &(patch "a\nb\nc\nd\ne" "@@ -5,0 +6,2 @@\n+Y\n+Z")
      "patch appends a zero-count hunk at the end")
    (assert-equal test
      &(Maybe.Just @"a\nB\nc")
      &(patch "a\nb\nc"
              "diff --git a/f b/f\nindex 1234567..89abcde 100644\n--- a/f\n+++ b/f\n@@ -1,3 +1,3 @@ section\n a\n-b\n+B\n c\n\\ No newline at end of file\n")
      "patch skips file headers before the first hunk")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a\nb\nc" "@@ -1,3 +1,3 @@\n a\n-b")
      "patch returns Nothing on a truncated hunk")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a" "@@ -1 +1 section\n-a\n+A")
      "patch returns Nothing on a hunk header without its closing @@")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a\nb" "@@ -1,2 +1,1 @@\n a\n b")
      "patch returns Nothing on a hunk with too many context lines")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a" "@@ -1 +1 @@\n+X\n+Y\n-a")
      "patch returns Nothing on a hunk with too many + lines")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a\nb" "@@ -1 +1 @@\n-a\n-b\n+X")
      "patch returns Nothing on a hunk with too many - lines")
    (assert-equal test
      &(Maybe.Just @"a\n++ y\nb")
      &(patch "a\n-- x\nb"
              "@@ -1,3 +1,3 @@\n a\n--- x\n+++ y\n b\n\\ No newline at end of file")
      "patch reads --- and +++ inside a hunk as body lines")
    (assert-equal test
      &(Maybe.Just @"a\nB")
      &(patch "a\nb"
              "@@ -2 +2 @@\n-b\n\\ No newline at end of file\n+B\n\\ No newline at end of file")
      "patch honours no-newline markers")
    (assert-equal test
      &(Maybe.Just @"a\nb\n")
      &(patch "a\nb"
              "--- old1\t2026-11-05 20:54:39.175383874 +0100\n+++ new1\t2026-11-05 20:54:39.175383874 +0100\n@@ -1,2 +1,2 @@\n a\n-b\n\\ No newline at end of file\n+b\n")
      "patch adds the final newline a diff -u marker asks for")
    (assert-equal test
      &(Maybe.Just @"a")
      &(patch ""
              "--- e\t2026-11-05 20:54:39.175383874 +0100\n+++ a1\t2026-11-05 20:54:39.175383874 +0100\n@@ -0,0 +1 @@\n+a\n\\ No newline at end of file\n")
      "patch reads an empty original as no lines")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a\nb\n" "@@ -2 +2 @@\n-b\n\\ No newline at end of file\n+B")
      "patch returns Nothing on a no-newline marker the original contradicts")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a\nb" "@@ -2 +2 @@\n-b\n+B")
      "patch returns Nothing when the last line of the original lacks its marker")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a\nb\nc\n" "@@ -1 +1,2 @@\n a\n+X\n\\ No newline at end of file")
      "patch returns Nothing on a no-newline marker before the last line")
    (assert-equal test
      &(the (Maybe String) (Maybe.Nothing))
      &(patch "a\nb"
              "--- a/f\n+++ b/f\n@@ -1 +1 @@\n-a\n+A\n--- a/g\n+++ b/g\n@@ -2 +2 @@\n-b\n+B")
      "patch returns Nothing on a second file")
    (assert-equal test
      &(Maybe.Just @"a\nX\nb\nc\ne\nY")
      &(patch "a\nb\nc\nd\ne"
              &(unified-with-context
                &(line-diff "a\nb\nc\nd\ne" "a\nX\nb\nc\ne\nY")
                0))
      "patch round-trips unified-with-context 0")))
